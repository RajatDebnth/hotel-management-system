APP_NAME=Hotel Management API
APP_ENV=development
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
LOG_LEVEL=INFO
ENQUIRY_RATE_LIMIT=5
ENQUIRY_RATE_WINDOW_SECONDS=60

# Database paths default to backend/data and need no environment variables.

# Temporary until local Auth and Storage replace the remaining Supabase services.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
